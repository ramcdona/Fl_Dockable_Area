@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(FLTK CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/Fl_Dockable_AreaTargets.cmake")
check_required_components(Fl_Dockable_Area)
