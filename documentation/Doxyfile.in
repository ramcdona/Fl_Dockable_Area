# Doxygen configuration of the Fl_Dockable_Area manual, after FLTK's own.
# CMake fills in the @...@ values.

PROJECT_NAME           = "Fl_Dockable_Area @PROJECT_VERSION@"
OUTPUT_DIRECTORY       = .
OUTPUT_LANGUAGE        = English
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MARKDOWN_SUPPORT       = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_LOCAL_METHODS  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = NO
SHOW_INCLUDE_FILES     = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = @LOGFILE@
INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/src/index.dox \
                         @CMAKE_CURRENT_SOURCE_DIR@/src/intro.dox \
                         @CMAKE_CURRENT_SOURCE_DIR@/src/guide.dox \
                         @CMAKE_CURRENT_SOURCE_DIR@/src/design.dox \
                         @CMAKE_CURRENT_SOURCE_DIR@/src/license.dox \
                         @PROJECT_SOURCE_DIR@/FL \
                         @PROJECT_SOURCE_DIR@/src
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.H \
                         *.cxx
RECURSIVE              = NO
# The groups the area makes for itself are not part of the interface
EXCLUDE                = @PROJECT_SOURCE_DIR@/src/Fl_Dockable_Private.H \
                         @PROJECT_SOURCE_DIR@/src/Fl_Dockable_Bar.H \
                         @PROJECT_SOURCE_DIR@/src/Fl_Dockable_Bar.cxx \
                         @PROJECT_SOURCE_DIR@/src/Fl_Dockable_Stack.H \
                         @PROJECT_SOURCE_DIR@/src/Fl_Dockable_Stack.cxx \
                         @PROJECT_SOURCE_DIR@/src/Fl_Dockable_Stripe.H \
                         @PROJECT_SOURCE_DIR@/src/Fl_Dockable_Stripe.cxx \
                         @PROJECT_SOURCE_DIR@/src/Fl_Dockable_Tabs.H \
                         @PROJECT_SOURCE_DIR@/src/Fl_Dockable_Tabs.cxx
EXAMPLE_PATH           = @PROJECT_SOURCE_DIR@ \
                         @PROJECT_SOURCE_DIR@/test
EXAMPLE_PATTERNS       = *.cxx \
                         COPYING
SOURCE_BROWSER         = NO
ALPHABETICAL_INDEX     = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_TIMESTAMP         = NO
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = FL_DOXYGEN \
                         FL_DOCKABLE_EXPORT= \
                         FL_OVERRIDE=override
HIDE_UNDOC_RELATIONS   = YES
HAVE_DOT               = NO
